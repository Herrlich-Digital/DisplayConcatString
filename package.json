{
  "name": "@Herrlich-Digital/DisplayConcatString",
  "description": "A simple try-catch wrapper for TypeScript inspired by Golang",
  "version": "1.0.0",
  "entrypoint": "index.ts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check-all": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "Concat",
    "String",
    "displayname",
    "array",
    "typescript"
  ],
  "author": "Christoph Planken <Herrlich Digital>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Herrlich-Digital//DisplayConcatString.git"
  }
}
